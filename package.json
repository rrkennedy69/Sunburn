{
  "name": "sunburn",
  "version": "0.1.0",
  "description": "SunBurn — a free browser app for laser cutting and engraving. Based on OpenBurn. GRBL over Web Serial, LightBurn .lbrn/.lbrn2, and Google Drive sync.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --port 4317 --strictPort",
    "dev:electron": "concurrently -k \"vite --port 4317 --strictPort\" \"wait-on tcp:4317 && cross-env VITE_DEV_SERVER_URL=http://localhost:4317 electron .\"",
    "dev:build": "concurrently -k -n renderer,main \"vite build --watch\" \"tsc -p electron/tsconfig.json --watch --preserveWatchOutput\"",
    "build": "tsc --noEmit && vite build && tsc -p electron/tsconfig.json",
    "build:web": "tsc --noEmit && vite build",
    "build:app": "npm run build && electron-builder",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:fast": "playwright test --reporter=list",
    "test:e2e:watch": "concurrently -k -n build,e2e \"npm:dev:build\" \"wait-on dist-electron/main.js && npm run test:e2e:fast\"",
    "docs:screenshots": "CAPTURE_SESSION=1 NODE_ENV=development vite build --mode development && tsc -p electron/tsconfig.json && CAPTURE_DOCS=1 playwright test --config playwright.docs.config.ts && sh scripts/build-docs-assets.sh",
    "docs:brand": "node scripts/build-brand-assets.mjs",
    "docs:icon": "NODE_ENV=development vite build --mode development && tsc -p electron/tsconfig.json && CAPTURE_DOCS=1 playwright test --config playwright.docs.config.ts screenshot-icon",
    "check:flatpak-sources": "node scripts/check-flatpak-sources.mjs",
    "site:dev": "npm --prefix website run dev",
    "site:build": "npm --prefix website run build",
    "site:test": "npm --prefix website run build && npm --prefix website test",
    "site:deploy": "npm --prefix website run build && npx wrangler pages deploy website/dist --project-name openburn --branch main --commit-dirty=true"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "fabric": "^6.5.1",
    "imagetracerjs": "^1.2.6",
    "opentype.js": "^1.3.4",
    "paper": "^0.12.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.1.3",
    "puppeteer-core": "^25.16.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "io.github.rrkennedy69.SunBurn",
    "productName": "SunBurn",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "rrkennedy69",
        "repo": "Sunburn",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics",
      "syncDesktopName": true
    },
    "win": {
      "target": "nsis"
    }
  },
  "license": "MIT",
  "author": "SunBurn contributors",
  "engines": {
    "node": ">=22.22.0"
  },
  "homepage": "https://rrkennedy69.github.io/Sunburn/",
  "repository": {
    "type": "git",
    "url": "https://github.com/rrkennedy69/Sunburn.git"
  },
  "bugs": {
    "url": "https://github.com/rrkennedy69/Sunburn/issues"
  },
  "keywords": [
    "laser",
    "laser-cutter",
    "laser-engraver",
    "lightburn",
    "lbrn2",
    "grbl",
    "gerber",
    "electron",
    "react",
    "typescript",
    "fabricjs",
    "paperjs",
    "cad",
    "cam"
  ],
  "desktopName": "io.github.rrkennedy69.SunBurn"
}
